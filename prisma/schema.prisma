datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String               @id @default(cuid())
  name      String
  email     String               @unique
  password  String?              // Optional hashed/plain password for team login
  role      String               @default("MEMBER") // LEAD, MEMBER
  avatar    String?
  isActive  Boolean              @default(true)
  tasks     Task[]
  logs      DailyLog[]
  shifts    DailyShift[]
  threads   MonthlyEmailThread[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  status        String     @default("TODO") // TODO, IN_PROGRESS, DONE
  progress      Int        @default(0) // 0 - 100
  dueDate       DateTime?
  recurrence    String     @default("NONE") // NONE, DAILY, WEEKLY
  lastResetDate DateTime?
  startTime     String?    // e.g. "8.45" or "9.00"
  endTime       String?    // e.g. "9.00" or "5.30"
  priority      String     @default("High") // High, Medium, Low
  assignedBy    String     @default("Myself") // Altitude1, Nimesh, Myself, etc.
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks      Subtask[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  isDone    Boolean  @default(false)
  weight    Int?     // Optional percentage weight (0 - 100)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyLog {
  id        String   @id @default(cuid())
  summary   String
  blockers  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model DailyShift {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  shiftStartTime String?  // Check-in time e.g. "8.30"
  prepEndTime    String?  // Plan prep end e.g. "8.45"
  shiftEndTime   String?  // Check-out time e.g. "5.30"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
}

model MonthlyEmailThread {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey      String   // e.g. "2026-08"
  rootMessageId String   // The Message-ID of the first email of the month
  lastMessageId String?  // The Message-ID of the latest email
  subject       String   // The base subject of the thread
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, monthKey])
}

model AppConfig {
  id                    String   @id @default("global_config")
  smtpHost              String   @default("smtp.gmail.com")
  smtpPort              Int      @default(465)
  smtpUser              String   @default("")
  smtpPassword          String   @default("")
  smtpSecure            Boolean  @default(true)
  senderName            String   @default("Daily Focus & Team Tracker")
  emailRecipients       String   @default("") // Comma-separated fallback
  toRecipients          String   @default("") // Comma-separated To
  ccRecipients          String   @default("") // Comma-separated CC
  bccRecipients         String   @default("") // Comma-separated BCC
  morningReportTime     String   @default("08:00") // HH:MM
  eveningReportTime     String   @default("18:00") // HH:MM
  shiftStartTime        String   @default("8.30")
  prepEndTime           String   @default("8.45")
  shiftEndTime          String   @default("5.30")
  autoSendMorningReport Boolean  @default(false)
  autoSendDailyLog      Boolean  @default(false)
  defaultUserId         String?
  updatedAt             DateTime @updatedAt
}
